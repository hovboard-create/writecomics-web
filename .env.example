# =============================================================================
# Production env vars (set in Vercel project settings).
# When these are unset (local dev), the app falls back to a local SQLite file
# and writes panel PNGs to public/gen/ — no external accounts needed.
# =============================================================================

# Turso (libsql) — `turso db show <name>` to grab these
TURSO_DATABASE_URL=libsql://your-db-name-yourorg.turso.io
TURSO_AUTH_TOKEN=eyJhbGc...

# Vercel Blob storage — auto-injected when you attach a Blob store to the
# Vercel project, but listed here for completeness.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxx

# Site URL used for OG/Twitter image absolute URLs.
NEXT_PUBLIC_SITE_URL=https://writecomics.com
